# Obtain your own Telegram application credentials from https://my.telegram.org/apps.
# This file contains deliberately invalid examples, never an authorization session.
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here

# Native grammers sessions are created by `telegram-mcp login`.
# Existing Telethon session files and secret-chat keys must not be overwritten.
# XDG_STATE_HOME=/path/to/private/state

# Required for Docker Compose or an explicitly non-loopback HTTP listener.
# Generate a fresh private token of at least 32 characters before starting a service.
TELEGRAM_HTTP_TOKEN=not-configured
# Required together for any non-loopback listener, including Docker Compose.
# Use a certificate trusted by your clients; keep its private key outside Git.
# In Compose these are absolute HOST file paths, mounted read-only in the container.
# TELEGRAM_HTTP_TLS_CERT=/absolute/path/to/server.pem
# TELEGRAM_HTTP_TLS_KEY=/absolute/path/to/server-key.pem
# Remote MCP hostnames must also be explicitly allowed (comma-separated).
# TELEGRAM_HTTP_ALLOWED_HOSTS=mcp.example.com

# Local files the Telegram tools may read/write: configure only intentional roots.
# TELEGRAM_FILE_ROOTS=/path/to/telegram/files

# Runtime logs default to private state/mcp.log; use off for stderr-only logging.
# TELEGRAM_MCP_LOG_FILE=off

# Optional exposed-tool filters are applied before tools/list and tools/call.
# TELEGRAM_EXPOSED_TOOLS=read-only+send_message
# TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890:42,@team:7
