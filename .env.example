# Obtain your own Telegram application credentials from https://my.telegram.org/apps.
# This file contains deliberately invalid examples, never an authorization session.
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here

# Native grammers sessions are created by `telegram-mcp login`.
# Existing Telethon session files and secret-chat keys must not be overwritten.
# XDG_STATE_HOME=/path/to/private/state

# Required for Docker Compose or an explicitly non-loopback HTTP listener.
# Generate a fresh private token of at least 32 characters before starting a service.
TELEGRAM_HTTP_TOKEN=not-configured
# Required together for any non-loopback listener, including Docker Compose.
# Use a certificate trusted by your clients; keep its private key outside Git.
# In Compose these are absolute HOST file paths, mounted read-only in the container.
# TELEGRAM_HTTP_TLS_CERT=/absolute/path/to/server.pem
# TELEGRAM_HTTP_TLS_KEY=/absolute/path/to/server-key.pem
# Remote MCP hostnames must also be explicitly allowed (comma-separated).
# TELEGRAM_HTTP_ALLOWED_HOSTS=mcp.example.com

# Local files the Telegram tools may read/write: configure only intentional roots.
# TELEGRAM_FILE_ROOTS=/path/to/telegram/files

# Optional owner approval bot. Keep the BotFather token in your private .env.
# Each owner must open a private chat with the bot and send /start.
# TELEGRAM_APPROVAL_BOT_TOKEN=
# TELEGRAM_APPROVAL_OWNER_IDS=123456789,234567890
# TELEGRAM_APPROVAL_OWNER_ID=123456789
# TELEGRAM_APPROVAL_BOT_USERNAME=your_approval_bot
# TELEGRAM_APPROVAL_TIMEOUT_SECONDS=300

# Tool call timeout in seconds. Defaults to 55, or 120 for exports.
# Set 0 to disable the tool call timeout without changing approval deadlines.
# TELEGRAM_TOOL_TIMEOUT_SECONDS=

# Optional typed proxy settings. Set TYPE, HOST and PORT together. Do not mix
# these with TELEGRAM_PROXY_URL at the same scope. SECRET is for MTProto only.
# RDNS defaults to true and controls proxy-side DNS for SOCKS.
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=proxy.example.com
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_SECRET=
# TELEGRAM_PROXY_RDNS=true

# Optional Telegram client identity overrides. Leave unset to use native defaults.
# TELEGRAM_DEVICE_MODEL=
# TELEGRAM_SYSTEM_VERSION=
# TELEGRAM_APP_VERSION=

# Host used for Telegram links and recognized username prefixes.
# TELEGRAM_LINK_DOMAIN=t.me

# Seconds to wait for a session lock (default 20, range 0 to 300).
# Use 0 for one immediate attempt.
# TELEGRAM_LOCK_GRACE_SECONDS=20

# Optional private file paths for the incoming event feed and live aliases.
# TELEGRAM_EVENT_FEED_FILE=
# TELEGRAM_ALIASES_FILE=

# Optional fallback pool of native session strings, separated by commas,
# semicolons or whitespace. Session strings are credentials; use a private .env.
# TELEGRAM_SESSION_STRINGS=

# Optional JSON objects mapping error keys or decimal Telegram status codes
# to plain-text messages. These change the wording, not the refusal decision.
# TELEGRAM_REFUSALS={}
# TELEGRAM_REFUSAL_CODES={}

# Maximum source size for view_video in MiB (default 200, range 1 to 512).
# TELEGRAM_VIDEO_MAX_MB=200

# Runtime logs default to private state/mcp.log; use off for stderr-only logging.
# TELEGRAM_MCP_LOG_FILE=off

# Optional exposed-tool filters are applied before tools/list and tools/call.
# TELEGRAM_EXPOSED_TOOLS=read-only+send_message
# TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890:42,@team:7
